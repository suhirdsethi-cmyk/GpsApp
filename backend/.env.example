# Database settings (Defaults to SQLite for easy local dev if PostgreSQL is not running)
# PostgreSQL format: postgresql://postgres:postgres@localhost:5432/gpsdb
DATABASE_URL=sqlite:///./gpsapp.db

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_change_me_in_production_123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200 # 30 days

# Server Configuration
PORT=8000
HOST=0.0.0.0

# CORS settings (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# GPS Update Interval (Seconds)
DEFAULT_GPS_UPDATE_INTERVAL=10
